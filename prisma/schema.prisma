generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum InquiryType {
  VEHICLE_DEMO_REQUEST
  PRODUCT_INQUIRY
  ENERGY_CONSULTATION
  GENERAL
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum FavoriteItemType {
  VEHICLE
  ENERGY_PRODUCT
  SHOP_PRODUCT
}

enum SearchEventScope {
  ALL
  VEHICLE
  ENERGY
  SHOP
}

enum InquiryStatus {
  NEW
  PRIORITIZED
  FOLLOW_UP
  CLOSED
}

enum InquiryPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum UserIntentLevel {
  STANDARD
  ENGAGED
  HIGH_INTENT
}

enum AutomationRunStatus {
  SUCCESS
  PARTIAL_FAILURE
  FAILED
}

enum BackgroundJobKind {
  WEBHOOK_DELIVERY
  EMAIL_DELIVERY
  CACHE_INVALIDATION
  EXPORT_GENERATION
  ANALYTICS_AGGREGATION
}

enum BackgroundJobStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AuditAction {
  PRODUCT_CREATED
  PRODUCT_UPDATED
  PRODUCT_DELETED
  RANKING_CONFIG_UPDATED
  PRODUCT_RANKING_OVERRIDE_UPDATED
  PRODUCT_RANKING_OVERRIDE_REMOVED
  EXPORT_REQUESTED
  IMPORT_VALIDATED
  IMPORT_APPLIED
  WEBHOOK_REGISTRY_VIEWED
  BACKGROUND_JOBS_PROCESSED
}

model Vehicle {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  subtitle        String
  description     String   @db.Text
  price           String
  image           String
  primaryButton   String
  secondaryButton String
  specs           Json
  highlights      Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([title])
  @@map("vehicles")
}

model EnergyProduct {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  description     String   @db.Text
  longDescription String   @db.Text
  image           String
  primaryButton   String
  secondaryButton String
  highlights      Json
  detailFeatures  Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([title])
  @@map("energy_products")
}

model ShopProduct {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  description     String   @db.Text
  longDescription String   @db.Text
  image           String
  price           String
  primaryButton   String
  secondaryButton String
  badge           String?
  highlights      Json
  detailFeatures  Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([title])
  @@map("shop_products")
}

model RecommendationConfig {
  id                         String   @id
  favoritesWeight            Float    @default(5)
  recentlyViewedWeight       Float    @default(2.2)
  recentViewRecencyBonus     Float    @default(0.5)
  savedBuildWeight           Float    @default(5.5)
  inquiryWeight              Float    @default(4)
  categoryAffinityWeight     Float    @default(1.15)
  tokenAffinityWeight        Float    @default(0.72)
  sameTypeWeight             Float    @default(1.2)
  preferredTypeWeight        Float    @default(0.9)
  popularityWeight           Float    @default(1.2)
  freshnessWeight            Float    @default(0.6)
  adminBoostWeight           Float    @default(1)
  pinWeight                  Float    @default(8)
  vehicleCategoryBoost       Float    @default(1)
  energyCategoryBoost        Float    @default(1)
  shopCategoryBoost          Float    @default(1)
  searchPopularityWeight     Float    @default(0.18)
  searchFreshnessWeight      Float    @default(0.12)
  searchAdminBoostWeight     Float    @default(2)
  searchPinWeight            Float    @default(12)
  searchUserAffinityWeight   Float    @default(0.14)
  searchCategoryBoostWeight  Float    @default(1)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@map("recommendation_config")
}

model ProductRankingOverride {
  id         String           @id @default(cuid())
  itemType   FavoriteItemType
  itemSlug   String
  pinned     Boolean          @default(false)
  boostScore Float            @default(0)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([itemType, itemSlug])
  @@index([pinned, updatedAt])
  @@map("product_ranking_overrides")
}

model Inquiry {
  id          String            @id @default(cuid())
  type        InquiryType
  status      InquiryStatus     @default(NEW)
  priority    InquiryPriority   @default(NORMAL)
  name        String
  email       String
  phone       String?
  message     String            @db.Text
  productSlug String?
  itemType    FavoriteItemType?
  operationalTags String[]      @default([])
  lastAutomatedAt DateTime?
  userId      String?
  createdAt   DateTime          @default(now())
  user        User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([type, createdAt])
  @@index([status, priority, createdAt])
  @@index([productSlug])
  @@index([itemType])
  @@map("inquiries")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id                     String       @id @default(cuid())
  email                  String?      @unique
  emailVerified          DateTime?
  name                   String?
  image                  String?
  passwordHash           String?
  role                   UserRole     @default(CUSTOMER)
  intentLevel            UserIntentLevel @default(STANDARD)
  recommendationEligible Boolean      @default(false)
  intentQualifiedAt      DateTime?
  buildReminderOptIn     Boolean      @default(true)
  productUpdatesOptIn    Boolean      @default(false)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  accounts               Account[]
  automationEventLogs    AutomationEventLog[]
  auditLogs              AuditLog[]
  favorites              Favorite[]
  inquiries              Inquiry[]
  recentlyViewed RecentlyViewed[]
  savedBuilds            SavedBuild[]
  searchEvents           SearchEvent[]
  sessions               Session[]

  @@map("users")
}

model Favorite {
  id        String           @id @default(cuid())
  userId    String
  itemType  FavoriteItemType
  itemSlug  String
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemType, itemSlug])
  @@index([itemType, itemSlug])
  @@map("favorites")
}

model SavedBuild {
  id              String   @id @default(cuid())
  userId          String
  vehicleSlug     String
  vehicleTitle    String
  vehicleImage    String
  vehiclePrice    String
  buildLabel      String?
  selectedOptions Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@index([vehicleSlug])
  @@map("saved_builds")
}

model RecentlyViewed {
  id           String           @id @default(cuid())
  userId       String
  itemType     FavoriteItemType
  itemSlug     String
  viewCount    Int              @default(1)
  createdAt    DateTime         @default(now())
  lastViewedAt DateTime         @default(now())
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemType, itemSlug])
  @@index([userId, lastViewedAt])
  @@index([itemType, itemSlug])
  @@map("recently_viewed")
}

model SearchEvent {
  id                String            @id @default(cuid())
  userId            String?
  query             String            @db.Text
  normalizedQuery   String
  scope             SearchEventScope  @default(ALL)
  resultCount       Int
  topResultItemType FavoriteItemType?
  createdAt         DateTime          @default(now())
  user              User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([normalizedQuery, createdAt])
  @@index([scope, createdAt])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("search_events")
}

model AutomationEventLog {
  id         String              @id @default(cuid())
  eventType  String
  entityType String
  entityId   String
  handler    String
  status     AutomationRunStatus
  message    String              @db.Text
  payload    Json?
  metadata   Json?
  userId     String?
  createdAt  DateTime            @default(now())
  user       User?               @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventType, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("automation_event_logs")
}

model BackgroundJob {
  id           String              @id @default(cuid())
  kind         BackgroundJobKind
  status       BackgroundJobStatus @default(PENDING)
  dedupeKey    String?             @unique
  payload      Json
  attempts     Int                 @default(0)
  maxAttempts  Int                 @default(3)
  runAfter     DateTime            @default(now())
  lockedAt     DateTime?
  lockedBy     String?
  lastError    String?             @db.Text
  completedAt  DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([status, runAfter])
  @@index([kind, status, runAfter])
  @@index([createdAt])
  @@map("background_jobs")
}

model AuditLog {
  id          String      @id @default(cuid())
  action      AuditAction
  entityType  String
  entityId    String?
  message     String      @db.Text
  metadata    Json?
  requestId   String?
  actorUserId String?
  actorEmail  String?
  actorRole   UserRole?
  createdAt   DateTime    @default(now())
  actor       User?       @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
