generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum InquiryType {
  VEHICLE_DEMO_REQUEST
  PRODUCT_INQUIRY
  ENERGY_CONSULTATION
  GENERAL
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum FavoriteItemType {
  VEHICLE
  ENERGY_PRODUCT
  SHOP_PRODUCT
}

model Vehicle {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  subtitle        String
  description     String   @db.Text
  price           String
  image           String
  primaryButton   String
  secondaryButton String
  specs           Json
  highlights      Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([title])
  @@map("vehicles")
}

model EnergyProduct {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  description     String   @db.Text
  longDescription String   @db.Text
  image           String
  primaryButton   String
  secondaryButton String
  highlights      Json
  detailFeatures  Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([title])
  @@map("energy_products")
}

model ShopProduct {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  description     String   @db.Text
  longDescription String   @db.Text
  image           String
  price           String
  primaryButton   String
  secondaryButton String
  badge           String?
  highlights      Json
  detailFeatures  Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([title])
  @@map("shop_products")
}

model Inquiry {
  id          String            @id @default(cuid())
  type        InquiryType
  name        String
  email       String
  phone       String?
  message     String            @db.Text
  productSlug String?
  itemType    FavoriteItemType?
  userId      String?
  createdAt   DateTime          @default(now())
  user        User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([type, createdAt])
  @@index([productSlug])
  @@index([itemType])
  @@map("inquiries")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id           String     @id @default(cuid())
  email        String?    @unique
  emailVerified DateTime?
  name         String?
  image        String?
  passwordHash String?
  role         UserRole   @default(CUSTOMER)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  accounts     Account[]
  favorites    Favorite[]
  inquiries    Inquiry[]
  sessions     Session[]

  @@map("users")
}

model Favorite {
  id        String           @id @default(cuid())
  userId    String
  itemType  FavoriteItemType
  itemSlug  String
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemType, itemSlug])
  @@index([itemType, itemSlug])
  @@map("favorites")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
